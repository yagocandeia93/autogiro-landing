# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (REST) — https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend (envio do e-mail com o código OTP) — https://resend.com/api-keys
RESEND_API_KEY=
# Precisa ser um remetente do domínio verificado no Resend (não dá pra usar
# um Gmail comum aqui). Ex.: contato@autogirodms.com.br
RESEND_FROM_EMAIL=

# Caixa que recebe o aviso de "lead novo" disparado em /api/signup-intent.
# Aqui pode ser um endereço comum (é destinatário, não remetente). Sem essa
# variável, o aviso vai para yagocandeia93@gmail.com.
LEAD_NOTIFICATION_EMAIL=

# Muro 1 — gateway de pagamento. Escolha "asaas" ou "pagarme" (decisão de
# sexta). Sem essa variável, o código assume "asaas".
PAYMENT_GATEWAY=

# Preencher só a chave do gateway escolhido.
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=
PAGARME_API_KEY=
PAGARME_WEBHOOK_SECRET=

# Ponte para o app principal (app.autogirodms.com.br, Railway) — usada só
# dentro do webhook de pagamento, e só depois que existir um endpoint
# interno de provisionamento lá (ainda não existe, ver README).
AUTOGIRO_APP_URL=
PROVISIONING_SHARED_SECRET=
